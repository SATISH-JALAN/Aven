# Arena service + scripts. Placeholders only; never commit real keys.
BOT_PK=0x_your_arena_bot_private_key
SHOCK_PK=0x_your_shock_wallet_private_key
HYPEREVM_RPC=https://rpc.hyperliquid-testnet.xyz/evm
HL_INFO_API_TESTNET=https://api.hyperliquid-testnet.xyz/info
HL_INFO_API_MAINNET=https://api.hyperliquid.xyz/info
ARENA_ADMIN_TOKEN=change_me
ARENA_CORS_ORIGINS=http://localhost:3000

# Optional Arena knobs (defaults shown)
# CHAIN_ID=998
# ARENA_PORT=8787
# MAX_TRADE_BASE=5            # max exact-input per bot trade (base, human units)
# MAX_TRADE_QUOTE=10000       # max exact-input per bot trade (quote, human units)
# SHOCK_QUOTE=40000           # default shock: buy base with this much quote
# SHOCK_BASE=15               # default shock size when selling base
# MIN_NATIVE_BALANCE=0.01     # auto-pause the bot below this much native gas token
# NATIVE_USD=0                # USD per native token for the gas term of profit (testnet: 0)
# POLL_MS=500
# POST_RATE_LIMIT_PER_MIN=30
# ARENA_TRUST_PROXY=0         # 1 only behind cloudflared/a proxy: then the LAST X-Forwarded-For entry identifies clients
# ARENA_MAX_SSE_CLIENTS=500   # concurrent /stream clients (503 beyond)
# ARENA_VERIFY_LIMIT_PER_MIN=60  # GET /verify/:tx per client per minute (429 beyond)

# Mainnet (999), docs/DEPLOYMENTS.md §M. The Arena refuses to start on 999 unless NATIVE_USD > 0 and the admin token
# has >= 24 characters. HYPEREVM_RPC must be a DEDICATED endpoint: the public one allows 100 requests/min, and the
# Arena makes 118/min idle and ~1,900/min active.
# CHAIN_ID=999
# HYPEREVM_RPC=https://<your-dedicated-hyperevm-mainnet-rpc>
# NATIVE_USD=78                # HYPE price in USD (gas is real money)
# MAX_GAS_PRICE_GWEI=2         # required on 999: base fee measured 0.10-10.8 gwei in 3 h; above the cap the bot waits
# ARENA_ADMIN_TOKEN=<openssl rand -hex 24>
# MAX_TRADE_BASE=100
# MAX_TRADE_QUOTE=250000
