{
  "name": "@aven/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aven backend scripts: local chain, market data, replay export, demo.",
  "scripts": {
    "local:up": "tsx local-chain.ts",
    "local:once": "tsx local-chain.ts --once",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json",
    "fetch-market-data": "tsx fetch-market-data.ts",
    "replay": "tsx replay.ts",
    "replay-to-web": "tsx replay-to-web.ts",
    "proofs": "tsx proofs.ts",
    "demo": "tsx demo.ts",
    "live:check": "tsx live-check.ts"
  },
  "dependencies": {
    "@aven/core": "workspace:*",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "exports": {
    "./src/localChain.ts": "./src/localChain.ts",
    "./src/demo.ts": "./src/demo.ts",
    "./src/priceRelay.ts": "./src/priceRelay.ts",
    "./src/readOnlyRpc.ts": "./src/readOnlyRpc.ts"
  }
}
