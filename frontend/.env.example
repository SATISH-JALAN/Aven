# Next.js app. Everything here is public (NEXT_PUBLIC_*); never put keys in this file.
# Copy to .env.local. Addresses come from src/config/deployments.json (pnpm --filter @aven/web sync:deployments).
NEXT_PUBLIC_CHAIN_ID=999
# Public mainnet RPC: 100 requests/min per IP. Use a dedicated endpoint for heavy use. Testnet: 998 + https://rpc.hyperliquid-testnet.xyz/evm
NEXT_PUBLIC_RPC=https://rpc.hyperliquid.xyz/evm
NEXT_PUBLIC_ARENA_API=http://localhost:8787
# live | recorded | (empty = live, falling back to recorded when the Arena service is unreachable)
NEXT_PUBLIC_MODE=
# Privy app id (dashboard.privy.io). Empty = login button shows "not configured".
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_REPO_URL=https://github.com/SATISH-JALAN/Aven
NEXT_PUBLIC_VIDEO_URL=
